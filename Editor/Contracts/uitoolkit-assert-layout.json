{
  "route": "uitoolkit/assert-layout",
  "description": "Assert UI Toolkit runtime layout constraints such as edge touching, containment, and size.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "documentInstanceId": {
        "type": "number",
        "description": "UIDocument instance id from uitoolkit/runtime-documents."
      },
      "gameObjectPath": {
        "type": "string",
        "description": "Scene GameObject path that owns the UIDocument."
      },
      "gameObjectName": {
        "type": "string",
        "description": "Scene GameObject name that owns the UIDocument."
      },
      "documentName": {
        "type": "string",
        "description": "UIDocument component name."
      },
      "includeInactive": {
        "type": "boolean",
        "description": "Include inactive scene UIDocuments. Defaults to true."
      },
      "assertions": {
        "type": "array",
        "description": "Layout assertions. Supported types: edge-touch, same-edge, same-center, inside, size.",
        "items": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Element tree path."
            },
            "elementPath": {
              "type": "string",
              "description": "Legacy element tree path alias."
            },
            "visualElementPath": {
              "type": "string",
              "description": "Slash-separated VisualElementPath names."
            },
            "visualElementNames": {
              "type": "array",
              "description": "VisualElementPath names.",
              "items": {
                "type": "string"
              }
            },
            "name": {
              "type": "string",
              "description": "VisualElement.name exact match."
            },
            "firstPath": {
              "type": "string",
              "description": "Prefixed element tree path."
            },
            "firstVisualElementPath": {
              "type": "string",
              "description": "Prefixed slash-separated VisualElementPath names."
            },
            "firstNames": {
              "type": "array",
              "description": "Prefixed VisualElementPath names.",
              "items": {
                "type": "string"
              }
            },
            "firstName": {
              "type": "string",
              "description": "Prefixed VisualElement.name exact match."
            },
            "secondPath": {
              "type": "string",
              "description": "Prefixed element tree path."
            },
            "secondVisualElementPath": {
              "type": "string",
              "description": "Prefixed slash-separated VisualElementPath names."
            },
            "secondNames": {
              "type": "array",
              "description": "Prefixed VisualElementPath names.",
              "items": {
                "type": "string"
              }
            },
            "secondName": {
              "type": "string",
              "description": "Prefixed VisualElement.name exact match."
            },
            "innerPath": {
              "type": "string",
              "description": "Prefixed element tree path."
            },
            "innerVisualElementPath": {
              "type": "string",
              "description": "Prefixed slash-separated VisualElementPath names."
            },
            "innerNames": {
              "type": "array",
              "description": "Prefixed VisualElementPath names.",
              "items": {
                "type": "string"
              }
            },
            "innerName": {
              "type": "string",
              "description": "Prefixed VisualElement.name exact match."
            },
            "outerPath": {
              "type": "string",
              "description": "Prefixed element tree path."
            },
            "outerVisualElementPath": {
              "type": "string",
              "description": "Prefixed slash-separated VisualElementPath names."
            },
            "outerNames": {
              "type": "array",
              "description": "Prefixed VisualElementPath names.",
              "items": {
                "type": "string"
              }
            },
            "outerName": {
              "type": "string",
              "description": "Prefixed VisualElement.name exact match."
            },
            "type": {
              "type": "string",
              "description": "Layout assertion type."
            },
            "kind": {
              "type": "string",
              "description": "Legacy layout assertion type alias."
            },
            "axis": {
              "type": "string",
              "description": "Comparison axis: x or y."
            },
            "edge": {
              "type": "string",
              "description": "Shared edge for alignment."
            },
            "firstEdge": {
              "type": "string",
              "description": "First element edge."
            },
            "secondEdge": {
              "type": "string",
              "description": "Second element edge."
            },
            "tolerance": {
              "type": "number",
              "description": "Allowed layout delta."
            },
            "width": {
              "type": "number",
              "description": "Expected width."
            },
            "height": {
              "type": "number",
              "description": "Expected height."
            },
            "expectedWidth": {
              "type": "number",
              "description": "Expected width alias."
            },
            "expectedHeight": {
              "type": "number",
              "description": "Expected height alias."
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false,
    "required": [
      "assertions"
    ],
    "$defs": {
      "unityJsonValue": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/unityJsonValue"
            }
          },
          {
            "type": "object",
            "properties": {},
            "additionalProperties": {
              "$ref": "#/$defs/unityJsonValue"
            }
          }
        ]
      }
    },
    "x-vmAutomationInputValidation": {
      "maximumWorkUnits": 65536,
      "maximumInputDepth": 64
    }
  },
