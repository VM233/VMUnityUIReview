            }
          }
        ]
      }
    }
  },
  "errorCodes": [
    "argument_conflict",
    "editor_window_ambiguous",
    "editor_window_not_found",
    "editor_window_selector_mismatch",
    "input_validation_limit",
    "invalid_arguments",
    "invalid_project_path",
    "invalid_timeout",
    "project_mismatch",
    "request_id_conflict",
    "requires_main_editor",
    "response_too_large",
    "tool_execution_failed"
  ]
}
