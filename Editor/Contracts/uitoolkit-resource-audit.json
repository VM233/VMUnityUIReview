{
  "route": "uitoolkit/resource-audit",
  "description": "Audit UI Toolkit elements for resolved background assets, generated child visuals, highlighted-state misuse, and scale metadata. Projects opting into rules.rejectDefaultControlAppearance also reject actual Unity default-theme paint and built-in UI resources, including generated parts, inherited text, boolean values and interaction/disabled states. Current attached runtime parts are checked by resource-audit; manual art review remains required.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "documentInstanceId": {
        "type": "number",
        "description": "UIDocument instance id from uitoolkit/runtime-documents."
      },
      "gameObjectPath": {
        "type": "string",
        "description": "Scene GameObject path that owns the UIDocument."
      },
      "gameObjectName": {
        "type": "string",
        "description": "Scene GameObject name that owns the UIDocument."
      },
      "documentName": {
        "type": "string",
        "description": "UIDocument component name."
      },
      "includeInactive": {
        "type": "boolean",
        "description": "Include inactive scene UIDocuments. Defaults to true."
      },
      "runtime": {
        "type": "boolean",
        "description": "Audit runtime UIDocument elements when true; otherwise audit EditorWindow UI Toolkit elements. Defaults to false."
      },
      "window": {
        "type": "string",
        "description": "EditorWindow type/title for editor audits."
      },
      "queries": {
        "type": "array",
        "description": "Optional list of element queries. Each accepts path, visualElementPath, name, className, typeName, text, expectedBackgroundContains, forbiddenBackgroundContains, requireBackground.",
        "items": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Element tree path."
            },
            "elementPath": {
              "type": "string",
              "description": "Legacy element tree path alias."
            },
            "visualElementPath": {
              "type": "string",
              "description": "Slash-separated VisualElementPath names."
            },
            "visualElementNames": {
              "type": "array",
              "description": "VisualElementPath names.",
              "items": {
                "type": "string"
              }
            },
            "name": {
              "type": "string",
              "description": "VisualElement.name exact match."
            },
            "className": {
              "type": "string",
              "description": "USS class exact match."
            },
            "typeName": {
              "type": "string",
              "description": "VisualElement type-name match."
            },
            "text": {
              "type": "string",
              "description": "TextElement text match."
            },
            "expectedBackgroundContains": {
              "type": "string",
              "description": "Required background reference substring."
            },
            "forbiddenBackgroundContains": {
              "type": "array",
              "description": "Forbidden background reference substrings.",
              "items": {
                "type": "string"
              }
            },
            "requireBackground": {
              "type": "boolean",
              "description": "Require a resolved background image."
            }
          },
          "additionalProperties": false
        }
      },
      "path": {
        "type": "string",
        "description": "Element tree path if queries is omitted."
      },
      "visualElementPath": {
        "type": "string",
        "description": "Slash-separated VisualElementPath names if queries is omitted."
      },
      "name": {
        "type": "string",
        "description": "VisualElement.name exact match if queries is omitted."
      },
      "expectedBackgroundContains": {
        "type": "string",
        "description": "Expected substring in resolved background asset path or name."
      },
      "forbiddenBackgroundContains": {
        "type": "array",
        "description": "Substrings that must not appear in the resolved background asset path or name.",
        "items": {
          "type": "string"
        }
      },
      "requireBackground": {
        "type": "boolean",
        "description": "Warn if the target has no resolved background image."
      },
      "warnHighlighted": {
        "type": "boolean",
        "description": "Warn when a target appears to use a highlighted asset. Defaults to true."
      },
      "maxDepth": {
        "type": "number",
        "description": "Descendant depth to scan for background resources. Defaults to 3."
      }
    },
    "additionalProperties": false,
    "$defs": {
      "unityJsonValue": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/unityJsonValue"
            }
          },
          {
            "type": "object",
            "properties": {},
            "additionalProperties": {
              "$ref": "#/$defs/unityJsonValue"
            }
          }
        ]
      }
    },
    "x-vmAutomationInputValidation": {
      "maximumWorkUnits": 65536,
      "maximumInputDepth": 64
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "valid": {
        "type": "boolean",
        "description": "`valid` response field for `uitoolkit/resource-audit`."
      },
      "runtime": {
        "type": "boolean",
        "description": "`runtime` response field for `uitoolkit/resource-audit`."
      },
      "context": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "instanceId": {
                "type": "string",
                "description": "`instanceId` response field for `uitoolkit/resource-audit`."
              },
              "name": {
                "type": "string",
                "description": "`name` response field for `uitoolkit/resource-audit`."
              },
              "enabled": {
                "type": "boolean",
                "description": "`enabled` response field for `uitoolkit/resource-audit`."
              },
              "gameObjectName": {
                "type": "string",
                "description": "`gameObjectName` response field for `uitoolkit/resource-audit`."
              },
              "gameObjectPath": {
                "type": "string",
                "description": "`gameObjectPath` response field for `uitoolkit/resource-audit`."
              },
              "gameObjectActive": {
                "type": "boolean",
                "description": "`gameObjectActive` response field for `uitoolkit/resource-audit`."
              },
              "visualTreeAsset": {
                "type": "string",
                "description": "`visualTreeAsset` response field for `uitoolkit/resource-audit`."
              },
              "visualTreeAssetPath": {
                "type": "string",
                "description": "`visualTreeAssetPath` response field for `uitoolkit/resource-audit`."
              },
              "panelSettings": {
                "type": "string",
                "description": "`panelSettings` response field for `uitoolkit/resource-audit`."
              },
              "panelSettingsPath": {
                "type": "string",
                "description": "`panelSettingsPath` response field for `uitoolkit/resource-audit`."
              },
              "hasRootVisualElement": {
                "type": "boolean",
                "description": "`hasRootVisualElement` response field for `uitoolkit/resource-audit`."
              },
              "rootChildCount": {
                "type": "integer",
                "description": "`rootChildCount` response field for `uitoolkit/resource-audit`."
              },
              "rootWorldBound": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "description": "`x` response field for `uitoolkit/resource-audit`."
                      },
                      "y": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "description": "`y` response field for `uitoolkit/resource-audit`."
                      },
                      "width": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "description": "`width` response field for `uitoolkit/resource-audit`."
                      },
                      "height": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "description": "`height` response field for `uitoolkit/resource-audit`."
                      },
                      "xMin": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "description": "`xMin` response field for `uitoolkit/resource-audit`."
                      },
                      "yMin": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "description": "`yMin` response field for `uitoolkit/resource-audit`."
                      },
                      "xMax": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "description": "`xMax` response field for `uitoolkit/resource-audit`."
                      },
                      "yMax": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "description": "`yMax` response field for `uitoolkit/resource-audit`."
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y",
                      "width",
                      "height",
                      "xMin",
                      "yMin",
                      "xMax",
                      "yMax"
                    ]
                  }
                ],
                "description": "`rootWorldBound` response field for `uitoolkit/resource-audit`."
              }
            },
            "additionalProperties": false,
            "required": [
              "instanceId",
              "name",
              "enabled",
              "gameObjectName",
              "gameObjectPath",
              "gameObjectActive",
              "visualTreeAsset",
              "visualTreeAssetPath",
              "panelSettings",
              "panelSettingsPath",
              "hasRootVisualElement",
              "rootChildCount",
              "rootWorldBound"
            ]
          },
          {
            "type": "object",
            "properties": {
              "instanceId": {
                "type": "string",
                "description": "`instanceId` response field for `uitoolkit/resource-audit`."
              },
              "title": {
                "type": "string",
                "description": "`title` response field for `uitoolkit/resource-audit`."
              },
              "type": {
                "type": "string",
                "description": "`type` response field for `uitoolkit/resource-audit`."
              },
              "fullType": {
                "type": "string",
                "description": "`fullType` response field for `uitoolkit/resource-audit`."
              },
              "hasRootVisualElement": {
                "type": "boolean",
                "description": "`hasRootVisualElement` response field for `uitoolkit/resource-audit`."
              },
              "rootChildCount": {
                "type": "integer",
                "description": "`rootChildCount` response field for `uitoolkit/resource-audit`."
              }
            },
            "additionalProperties": false,
            "required": [
              "instanceId",
              "title",
              "type",
              "fullType",
              "hasRootVisualElement",
              "rootChildCount"
            ]
          }
        ],
        "description": "`context` response field for `uitoolkit/resource-audit`."
      },
      "count": {
        "type": "integer",
        "description": "`count` response field for `uitoolkit/resource-audit`."
      },
      "audits": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "index": {
              "type": "integer",
              "description": "`index` response field for `uitoolkit/resource-audit`."
            },
            "query": {
              "type": "string",
              "description": "`query` response field for `uitoolkit/resource-audit`."
            },
            "found": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "`found` response field for `uitoolkit/resource-audit`."
            },
            "path": {
              "type": "string",
              "description": "`path` response field for `uitoolkit/resource-audit`."
            },
            "error": {
              "type": [
