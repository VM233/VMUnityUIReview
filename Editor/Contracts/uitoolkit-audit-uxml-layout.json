{
  "route": "uitoolkit/audit-uxml-layout",
  "description": "Audit authored UXML for required UI Builder previews, text ownership, layout, stylesheet and component contracts. Projects opting into rules.uxmlLocalizedText also reject unbound player text, including single-word titles, unless a reasoned invariant or runtime text owner is declared. Command syntax has no implicit exemption. Bound literal fallbacks and blank Labels remain errors independently of text ownership markers. Native enabled Button hover and pressed target styles must differ after the real theme/template cascade; missing, overridden, focus-only and incomplete feedback are errors. Runtime-generated controls and visual clarity require separate runtime evidence. Projects opting into rules.rejectDefaultControlAppearance also reject actual Unity default-theme paint and built-in UI resources, including generated parts, inherited text, boolean values and interaction/disabled states. Current attached runtime parts are checked by resource-audit; manual art review remains required. With that policy enabled, complete native control observations continue between Editor updates; source/domain changes, cancellation or failure produce incomplete coverage and retire every owned panel before publication. Optional validateWorkContextOwnership compares actual serialized producer bindings and native UIDocument/template targets; independent work contexts sharing one navigated page fail.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "paths": {
        "type": "array",
        "description": "Optional Assets-relative UXML files. Omit to audit every UXML file in the effective roots.",
        "items": {
          "type": "string"
        }
      },
      "roots": {
        "type": "array",
        "description": "Assets-relative roots used to index UXML and USS files. Defaults to the project audit settings, then Assets.",
        "items": {
          "type": "string"
        }
      },
      "runtimeSourceRoots": {
        "type": "array",
        "description": "Assets-relative roots scanned for runtime UI element-name references. Defaults to the project audit settings, then Assets.",
        "items": {
          "type": "string"
        }
      },
      "excludePaths": {
        "type": "array",
        "description": "Assets-relative files or folders excluded from indexing.",
        "items": {
          "type": "string"
        }
      },
      "useProjectSettings": {
        "type": "boolean",
        "description": "Use ProjectSettings/VMUnityAutomationUIToolkitAudit.json as the default scope. Defaults to true."
      },
      "pixelGridEnabled": {
        "type": "boolean",
        "description": "Override the project pixel-grid audit switch. The project/default value is used when omitted."
      },
      "pixelGridStep": {
        "type": "number",
        "description": "Override the positive pixel-grid step, such as 3 or 4."
      },
      "includeSuppressed": {
        "type": "boolean",
        "description": "Include findings with a reasoned uxml-layout-audit suppression comment. Defaults to false."
      },
      "logWarnings": {
        "type": "boolean",
        "description": "Also write active findings to the Unity Console. Defaults to false."
      },
      "runSelfTests": {
        "type": "boolean",
        "description": "Run deterministic in-memory rule tests and return their result. Defaults to false."
      },
      "maxIssues": {
        "type": "number",
        "description": "Maximum returned findings. Defaults to 200; capped at 5000.",
        "x-vmAutomationDefaultSource": "VM Unity Automation user default result limit (when override is enabled)",
        "x-vmAutomationExplicitValueWins": true
      }
    },
    "additionalProperties": false,
    "$defs": {
      "unityJsonValue": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/unityJsonValue"
            }
          },
          {
            "type": "object",
            "properties": {},
            "additionalProperties": {
              "$ref": "#/$defs/unityJsonValue"
            }
          }
        ]
      }
    },
    "x-vmAutomationInputValidation": {
      "maximumWorkUnits": 65536,
      "maximumInputDepth": 64
    }
  },
