{
  "route": "uitoolkit/audit-uss-styles",
  "description": "Audit USS authoring and ownership contracts. Hard errors include grouped selector lists, margin or padding shorthand, empty selector blocks, resetting a loaded shared font to none or initial, fixed font size combined with effective auto sizing, fully inlineable single-consumer selectors, invariant declarations retained only by state anchors, repeated declaration bundles, redundant component classes, and page-scoped styles that cross reusable component ownership. It also reports ineffective or redundant layout, text, and background scale-mode declarations while preserving bounded flex, visual, interaction, state, and measured optical contracts. Native enabled Button hover and pressed target styles must differ after the real theme/template cascade; missing, overridden, focus-only and incomplete feedback are errors. Unity 6000.6+ USS-only feedback scope uses native pseudo-independent matches in the requested sheets and their imports, including affected ancestors and descendants. UXML, theme and earlier-engine requests retain whole-host coverage. Runtime-generated controls and visual clarity require separate runtime evidence.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "paths": {
        "type": "array",
        "description": "Optional Assets-relative USS files. Omit to audit every USS file in the effective roots.",
        "items": {
          "type": "string"
        }
      },
      "roots": {
        "type": "array",
        "description": "Assets-relative roots used to index USS and UXML files. Defaults to the project audit settings, then Assets.",
        "items": {
          "type": "string"
        }
      },
      "runtimeSourceRoots": {
        "type": "array",
        "description": "Assets-relative roots scanned for UI Toolkit runtime class API references. Defaults to the project audit settings, then Assets.",
        "items": {
          "type": "string"
        }
      },
      "excludePaths": {
        "type": "array",
        "description": "Assets-relative files or folders excluded from indexing.",
        "items": {
          "type": "string"
        }
      },
      "useProjectSettings": {
        "type": "boolean",
        "description": "Use ProjectSettings/VMUnityAutomationUIToolkitAudit.json as the default scope. Defaults to true."
      },
      "pixelGridEnabled": {
        "type": "boolean",
        "description": "Override the project pixel-grid audit switch. The project/default value is used when omitted."
      },
      "pixelGridStep": {
        "type": "number",
        "description": "Override the positive pixel-grid step, such as 3 or 4."
      },
      "includeSuppressed": {
        "type": "boolean",
        "description": "Include findings with a reasoned uss-audit suppression comment. Defaults to false."
      },
      "logWarnings": {
        "type": "boolean",
        "description": "Also write active findings to the Unity Console. Defaults to false."
      },
      "runSelfTests": {
        "type": "boolean",
        "description": "Run deterministic in-memory rule tests and return their result. Defaults to false."
      },
      "maxIssues": {
        "type": "number",
        "description": "Maximum returned findings. Defaults to 200; capped at 5000.",
        "x-vmAutomationDefaultSource": "VM Unity Automation user default result limit (when override is enabled)",
        "x-vmAutomationExplicitValueWins": true
      }
    },
    "additionalProperties": false,
    "$defs": {
      "unityJsonValue": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/unityJsonValue"
            }
          },
          {
            "type": "object",
            "properties": {},
            "additionalProperties": {
              "$ref": "#/$defs/unityJsonValue"
            }
          }
        ]
      }
    },
    "x-vmAutomationInputValidation": {
      "maximumWorkUnits": 65536,
      "maximumInputDepth": 64
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "passed": {
        "type": "boolean",
        "description": "`passed` response field for `uitoolkit/audit-uss-styles`."
      },
      "warningCount": {
        "type": "integer",
        "description": "`warningCount` response field for `uitoolkit/audit-uss-styles`."
      },
