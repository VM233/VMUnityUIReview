{
  "route": "uitoolkit/asset-inspect",
  "description": "Inspect UXML and USS assets for VisualElement names, types, unconditional class defaults, contextual selectors, and pseudo-state rules.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "uxmlPath": {
        "type": "string",
        "description": "UXML asset path, e.g. Assets/UI/HUD.uxml."
      },
      "ussPath": {
        "type": "string",
        "description": "Optional USS asset path. UXML Style src entries are also auto-resolved."
      },
      "ussPaths": {
        "type": "array",
        "description": "Optional USS asset paths. UXML Style src entries are also auto-resolved.",
        "items": {
          "type": "string"
        }
      },
      "name": {
        "type": "string",
        "description": "VisualElement.name exact match."
      },
      "names": {
        "type": "array",
        "description": "VisualElement.name values to validate.",
        "items": {
          "type": "string"
        }
      },
      "className": {
        "type": "string",
        "description": "USS class exact match."
      },
      "typeName": {
        "type": "string",
        "description": "Expected or filtered VisualElement type name."
      },
      "maxResults": {
        "type": "number",
        "description": "Total result budget for elements and name matches. Defaults to 100.",
        "x-vmAutomationDefaultSource": "VM Unity Automation user default result limit (when override is enabled)",
        "x-vmAutomationExplicitValueWins": true
      },
      "includeUss": {
        "type": "boolean",
        "description": "Parse USS files, keeping unconditional class defaults separate from contextual and pseudo-state rules. Defaults to true."
      },
      "includeElements": {
        "type": "boolean",
        "description": "Return the general elements collection. Defaults to false for names queries and true otherwise."
      },
      "includeAllUssClasses": {
        "type": "boolean",
        "description": "Return every parsed USS class. Targeted queries default to only classes used by returned elements."
      }
    },
    "additionalProperties": false,
    "$defs": {
      "unityJsonValue": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/unityJsonValue"
            }
          },
          {
            "type": "object",
            "properties": {},
            "additionalProperties": {
              "$ref": "#/$defs/unityJsonValue"
            }
          }
        ]
      }
    },
    "x-vmAutomationInputValidation": {
      "maximumWorkUnits": 65536,
      "maximumInputDepth": 64
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "uxmlPath": {
        "type": "string",
        "description": "`uxmlPath` response field for `uitoolkit/asset-inspect`."
      },
      "uxmlReadError": {
        "type": "string",
        "description": "`uxmlReadError` response field for `uitoolkit/asset-inspect`."
      },
      "ussPaths": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "`ussPaths` response field for `uitoolkit/asset-inspect`."
      },
      "elementCount": {
        "type": "integer",
        "description": "`elementCount` response field for `uitoolkit/asset-inspect`."
      },
      "query": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "`name` response field for `uitoolkit/asset-inspect`."
          },
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "`names` response field for `uitoolkit/asset-inspect`."
          },
          "className": {
            "type": "string",
            "description": "`className` response field for `uitoolkit/asset-inspect`."
          },
          "typeName": {
            "type": "string",
            "description": "`typeName` response field for `uitoolkit/asset-inspect`."
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "names",
          "className",
          "typeName"
        ],
        "description": "`query` response field for `uitoolkit/asset-inspect`."
      },
      "valid": {
        "type": "boolean",
        "description": "`valid` response field for `uitoolkit/asset-inspect`."
      },
      "nameChecks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "`name` response field for `uitoolkit/asset-inspect`."
            },
            "exists": {
              "type": "boolean",
              "description": "`exists` response field for `uitoolkit/asset-inspect`."
            },
            "matchCount": {
              "type": "integer",
              "description": "`matchCount` response field for `uitoolkit/asset-inspect`."
            },
            "typeMatches": {
              "type": "boolean",
