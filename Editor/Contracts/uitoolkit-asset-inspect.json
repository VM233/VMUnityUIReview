            },
            "matchesTruncated": {
              "type": "boolean",
              "description": "`matchesTruncated` response field for `uitoolkit/asset-inspect`."
            },
            "matches": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "`path` response field for `uitoolkit/asset-inspect`."
                  },
                  "type": {
                    "type": "string",
                    "description": "`type` response field for `uitoolkit/asset-inspect`."
                  },
                  "fullType": {
                    "type": "string",
                    "description": "`fullType` response field for `uitoolkit/asset-inspect`."
                  },
                  "name": {
                    "type": "string",
                    "description": "`name` response field for `uitoolkit/asset-inspect`."
                  },
                  "classes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "`classes` response field for `uitoolkit/asset-inspect`."
                  },
                  "inlineStyle": {
                    "type": "string",
                    "description": "`inlineStyle` response field for `uitoolkit/asset-inspect`."
                  },
                  "line": {
                    "type": "integer",
                    "description": "`line` response field for `uitoolkit/asset-inspect`."
                  },
                  "ussMatchedClasses": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "`ussMatchedClasses` response field for `uitoolkit/asset-inspect`."
                  },
                  "ussDefaultSize": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    },
                    "description": "`ussDefaultSize` response field for `uitoolkit/asset-inspect`."
                  },
                  "ussResolvedDeclarations": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    },
                    "description": "`ussResolvedDeclarations` response field for `uitoolkit/asset-inspect`."
                  }
                },
                "additionalProperties": false,
                "required": [
                  "path",
                  "type",
                  "fullType",
                  "name",
                  "classes",
                  "inlineStyle",
                  "line",
                  "ussMatchedClasses",
                  "ussDefaultSize",
                  "ussResolvedDeclarations"
                ]
              },
              "description": "`matches` response field for `uitoolkit/asset-inspect`."
            }
          },
          "additionalProperties": false,
          "required": [
            "name",
            "exists",
            "matchCount",
            "typeMatches",
            "reportedMatchCount",
            "matchesTruncated",
            "matches"
          ]
        },
        "description": "`nameChecks` response field for `uitoolkit/asset-inspect`."
      },
      "matchedCount": {
        "type": "integer",
        "description": "`matchedCount` response field for `uitoolkit/asset-inspect`."
      },
      "totalMatchedCount": {
        "type": "integer",
        "description": "`totalMatchedCount` response field for `uitoolkit/asset-inspect`."
      },
      "outputTruncated": {
        "type": "boolean",
        "description": "`outputTruncated` response field for `uitoolkit/asset-inspect`."
      },
      "includeElements": {
        "type": "boolean",
        "description": "`includeElements` response field for `uitoolkit/asset-inspect`."
      },
      "includeAllUssClasses": {
        "type": "boolean",
        "description": "`includeAllUssClasses` response field for `uitoolkit/asset-inspect`."
      },
      "elements": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
