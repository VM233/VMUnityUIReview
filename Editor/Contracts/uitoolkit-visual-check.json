{
  "route": "uitoolkit/visual-check",
  "description": "Run runtime UI Toolkit visual checks such as pixel-grid, background scale, and expected size.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "documentInstanceId": {
        "type": "number",
        "description": "UIDocument instance id from uitoolkit/runtime-documents."
      },
      "gameObjectPath": {
        "type": "string",
        "description": "Scene GameObject path that owns the UIDocument."
      },
      "gameObjectName": {
        "type": "string",
        "description": "Scene GameObject name that owns the UIDocument."
      },
      "documentName": {
        "type": "string",
        "description": "UIDocument component name."
      },
      "includeInactive": {
        "type": "boolean",
        "description": "Include inactive scene UIDocuments. Defaults to true."
      },
      "checks": {
        "type": "array",
        "description": "Visual checks. Supported type values: pixel-grid, background-scale, size.",
        "items": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Element tree path."
            },
            "elementPath": {
              "type": "string",
              "description": "Legacy element tree path alias."
            },
            "visualElementPath": {
              "type": "string",
              "description": "Slash-separated VisualElementPath names."
            },
            "visualElementNames": {
              "type": "array",
              "description": "VisualElementPath names.",
              "items": {
                "type": "string"
              }
            },
            "name": {
              "type": "string",
              "description": "VisualElement.name exact match."
            },
            "className": {
              "type": "string",
              "description": "USS class exact match."
            },
            "typeName": {
              "type": "string",
              "description": "VisualElement type-name match."
            },
            "text": {
              "type": "string",
              "description": "TextElement text match."
            },
            "type": {
              "type": "string",
              "description": "Visual check type."
            },
            "kind": {
              "type": "string",
              "description": "Legacy visual check type alias."
            },
            "pixelScale": {
              "type": "number",
              "description": "Pixel grid scale."
            },
            "tolerance": {
              "type": "number",
              "description": "Allowed numeric delta."
            },
            "expectedScale": {
              "type": "number",
              "description": "Expected background scale."
            },
            "scale": {
              "type": "number",
              "description": "Legacy expected background scale alias."
            },
            "width": {
              "type": "number",
              "description": "Expected element width."
            },
            "height": {
              "type": "number",
              "description": "Expected element height."
            },
            "expectedWidth": {
              "type": "number",
              "description": "Expected element width alias."
            },
            "expectedHeight": {
              "type": "number",
              "description": "Expected element height alias."
            }
          },
          "additionalProperties": false
        }
      },
      "path": {
        "type": "string",
        "description": "Element tree path if checks is omitted."
      },
      "visualElementPath": {
        "type": "string",
        "description": "Slash-separated VisualElementPath names if checks is omitted."
      },
      "pixelScale": {
        "type": "number",
        "description": "Pixel grid scale. Defaults to 1."
      },
      "expectedScale": {
        "type": "number",
        "description": "Expected background image scale for background-scale checks."
      },
      "width": {
        "type": "number",
        "description": "Expected element width for size checks."
      },
      "height": {
        "type": "number",
        "description": "Expected element height for size checks."
      },
      "tolerance": {
        "type": "number",
        "description": "Allowed pixel delta. Defaults to 0.01."
      }
    },
    "additionalProperties": false,
    "$defs": {
      "unityJsonValue": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/unityJsonValue"
            }
          },
          {
            "type": "object",
            "properties": {},
            "additionalProperties": {
              "$ref": "#/$defs/unityJsonValue"
            }
          }
        ]
      }
    },
    "x-vmAutomationInputValidation": {
      "maximumWorkUnits": 65536,
      "maximumInputDepth": 64
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "valid": {
        "type": "boolean",
        "description": "`valid` response field for `uitoolkit/visual-check`."
      },
      "document": {
        "type": "object",
        "properties": {
          "instanceId": {
            "type": "string",
            "description": "`instanceId` response field for `uitoolkit/visual-check`."
          },
          "name": {
            "type": "string",
            "description": "`name` response field for `uitoolkit/visual-check`."
          },
          "enabled": {
            "type": "boolean",
            "description": "`enabled` response field for `uitoolkit/visual-check`."
          },
          "gameObjectName": {
            "type": "string",
            "description": "`gameObjectName` response field for `uitoolkit/visual-check`."
          },
          "gameObjectPath": {
            "type": "string",
            "description": "`gameObjectPath` response field for `uitoolkit/visual-check`."
          },
          "gameObjectActive": {
            "type": "boolean",
            "description": "`gameObjectActive` response field for `uitoolkit/visual-check`."
          },
          "visualTreeAsset": {
            "type": "string",
            "description": "`visualTreeAsset` response field for `uitoolkit/visual-check`."
          },
          "visualTreeAssetPath": {
            "type": "string",
            "description": "`visualTreeAssetPath` response field for `uitoolkit/visual-check`."
          },
          "panelSettings": {
            "type": "string",
            "description": "`panelSettings` response field for `uitoolkit/visual-check`."
          },
          "panelSettingsPath": {
            "type": "string",
            "description": "`panelSettingsPath` response field for `uitoolkit/visual-check`."
          },
          "hasRootVisualElement": {
            "type": "boolean",
            "description": "`hasRootVisualElement` response field for `uitoolkit/visual-check`."
          },
          "rootChildCount": {
            "type": "integer",
            "description": "`rootChildCount` response field for `uitoolkit/visual-check`."
          },
          "rootWorldBound": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "`x` response field for `uitoolkit/visual-check`."
                  },
                  "y": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "`y` response field for `uitoolkit/visual-check`."
                  },
                  "width": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "`width` response field for `uitoolkit/visual-check`."
                  },
                  "height": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "`height` response field for `uitoolkit/visual-check`."
                  },
                  "xMin": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "`xMin` response field for `uitoolkit/visual-check`."
                  },
                  "yMin": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "`yMin` response field for `uitoolkit/visual-check`."
                  },
                  "xMax": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "`xMax` response field for `uitoolkit/visual-check`."
                  },
                  "yMax": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "`yMax` response field for `uitoolkit/visual-check`."
                  }
                },
                "additionalProperties": false,
                "required": [
                  "x",
                  "y",
                  "width",
                  "height",
                  "xMin",
                  "yMin",
                  "xMax",
                  "yMax"
                ]
              }
            ],
            "description": "`rootWorldBound` response field for `uitoolkit/visual-check`."
          }
        },
        "additionalProperties": false,
        "required": [
          "instanceId",
          "name",
          "enabled",
          "gameObjectName",
          "gameObjectPath",
          "gameObjectActive",
          "visualTreeAsset",
          "visualTreeAssetPath",
          "panelSettings",
          "panelSettingsPath",
          "hasRootVisualElement",
          "rootChildCount",
          "rootWorldBound"
        ],
        "description": "`document` response field for `uitoolkit/visual-check`."
      },
      "count": {
        "type": "integer",
        "description": "`count` response field for `uitoolkit/visual-check`."
      },
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "index": {
              "type": "integer",
              "description": "`index` response field for `uitoolkit/visual-check`."
            },
            "type": {
              "type": "string",
              "description": "`type` response field for `uitoolkit/visual-check`."
            },
            "path": {
              "type": "string",
              "description": "`path` response field for `uitoolkit/visual-check`."
            }
          },
          "additionalProperties": false,
          "required": [
            "index",
            "type",
            "path"
          ]
        },
        "description": "`results` response field for `uitoolkit/visual-check`."
      }
    },
    "additionalProperties": false,
    "required": [
      "valid",
      "document",
      "count",
      "results"
    ],
    "$defs": {
      "unityJsonValue": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/unityJsonValue"
            }
          },
          {
            "type": "object",
            "properties": {},
            "additionalProperties": {
              "$ref": "#/$defs/unityJsonValue"
            }
          }
        ]
      }
    }
  },
  "errorCodes": [
    "argument_conflict",
    "editor_window_ambiguous",
